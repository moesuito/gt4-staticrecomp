// Written from docs/hw-renderer-spec/CORE2-SPEC.md, clean room (decision 0070).
//
// Writes a native rectangle of stored GS words (read from GS memory on the CPU, in the target's format) into a
// target image at the internal scale: every output pixel of native pixel N's s x s block takes N's word (nearest,
// 8.2 ownership). Only the bits in `mask` are written, so a 24-bit upload into a shared 32/24 target keeps the
// stored top byte (1.3).

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer PatchWords {
    uint words[];
};
layout(set = 0, binding = 1, r32ui) uniform uimage2D target;

layout(push_constant) uniform PatchParameters {
    uint first_word;  // offset of the rectangle's first word in `words`
    uint x0;          // native rectangle
    uint y0;
    uint width;
    uint height;
    uint scale;
    uint mask;        // bits of the stored word that are written
} pc;

void main() {
    uvec2 local = gl_GlobalInvocationID.xy;  // output pixel inside the scaled rectangle
    if (local.x >= pc.width * pc.scale || local.y >= pc.height * pc.scale) {
        return;
    }
    uvec2 native = local / pc.scale;
    uint word = words[pc.first_word + native.y * pc.width + native.x];
    ivec2 pixel = ivec2(pc.x0 * pc.scale + local.x, pc.y0 * pc.scale + local.y);
    if (pixel.x >= imageSize(target).x || pixel.y >= imageSize(target).y) {
        return;
    }
    uint stored = pc.mask == 0xFFFFFFFFu ? word : (imageLoad(target, pixel).x & ~pc.mask) | (word & pc.mask);
    imageStore(target, pixel, uvec4(stored, 0u, 0u, 0u));
}
