// CORE2 CLUT load from a drawn target (TASK-027 core rewrite, IN-408). Copyright (c) 2026 GT4Recomp contributors.
// Written from docs/hw-renderer-spec chapters 07.1 to 07.7 and CORE2-SPEC 4.2, clean room (decision 0070).
//
// The same load as hw_glm_clut.comp (clut::ClutUnit::Copy: CSM1 positions, CSM2 TEXCLUT row, CT32 groups from CSA,
// CT16 entries at 16 * CSA), into the GPU copy of the CLUT buffer, but each entry is read where its newest value
// lives: in a 32-bit colour target the game drew (GT4 draws and filters its palettes on the GPU and loads a CLUT from
// them right away) or, outside that target's drawn and valid area, in the GLM. A target pixel is taken at its native
// centre, as the readback (core2_reduce.comp) takes it, so the palette equals the one a readback would have loaded.
// The target's pixel of a GS memory word comes from the inverse of the CT32 in-page layout (one entry per word of a
// page: x in bits 0-7, y in bits 8-15).

#version 450
#extension GL_GOOGLE_include_directive : require
#include "hw_glm_common.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 2) readonly buffer InverseCt32 {
    uint inverse_ct32[2048];  // word of a CT32 page -> pixel in the page
};
layout(set = 0, binding = 3, r32ui) uniform readonly uimage2D target;
layout(std430, set = 0, binding = 5) buffer ClutHalfwords {
    uint clut[512];
};

layout(push_constant) uniform ClutTargetLoad {
    uint cbp;          // CBP in blocks
    uint cpsm;         // CT32 (0x00), CT16 (0x02) or CT16S (0x0A)
    uint csm;          // 0: CSM1, 1: CSM2
    uint csa;
    uint eight_bit;    // 1: 256 entries (T8 family), 0: 16 entries (T4 family)
    uint cbw;          // TEXCLUT.CBW (CSM2)
    uint cou;          // TEXCLUT.COU
    uint cov;          // TEXCLUT.COV
    uint tbp;          // the target: base pointer (blocks), width (pages), native size
    uint tbw;
    uint twidth;
    uint theight;
    int held_x0;       // the target's drawn and valid area (inclusive, native pixels)
    int held_y0;
    int held_x1;
    int held_y1;
    uint full_word;    // 0: only 24-bit draws, the top byte stays in memory (the GLM)
    float scale;
} pc;

void main() {
    uint e = gl_GlobalInvocationID.x;
    uint count = pc.eight_bit != 0u ? 256u : 16u;
    if (e >= count) {
        return;
    }
    uint x;
    uint y;
    uint per_row = 1u;
    if (pc.csm == 0u) {
        if (pc.eight_bit != 0u) {
            x = (e & 7u) + 8u * ((e >> 4) & 1u);
            y = 2u * (e >> 5) + ((e >> 3) & 1u);
        } else {
            x = e & 7u;
            y = e >> 3;
        }
    } else {
        x = pc.cou * 16u + e;
        y = pc.cov;
        per_row = pc.cbw;
    }
    GlmSlot slot = glm_slot_rows(pc.cbp, per_row, pc.cpsm, x, y);
    uint word = glm_words[slot.word_index];

    // The target pixel that holds this GS memory word, if any.
    uint block = slot.word_index >> 6;  // 64 words per block
    uint offset = (block + 16384u - pc.tbp) & 16383u;
    uint per_target_row = max(pc.tbw, 1u);
    uint page = offset >> 5;
    uint in_page = inverse_ct32[((offset & 31u) << 6) | (slot.word_index & 63u)];
    int px = int((page % per_target_row) * 64u + (in_page & 255u));
    int py = int((page / per_target_row) * 32u + ((in_page >> 8) & 255u));
    if (px < int(pc.twidth) && py < int(pc.theight) && px >= pc.held_x0 && px <= pc.held_x1 && py >= pc.held_y0 &&
        py <= pc.held_y1) {
        ivec2 sample_at = min(ivec2(floor((vec2(px, py) + vec2(0.5)) * pc.scale)), imageSize(target) - ivec2(1));
        uint drawn = imageLoad(target, sample_at).x;
        word = pc.full_word != 0u ? drawn : ((drawn & 0x00FFFFFFu) | (word & 0xFF000000u));
    }
    uint raw = (word >> slot.shift) & slot.mask;

    if (pc.cpsm == 0u) {
        uint group = (e >> 4) + (pc.csa & 15u);
        if (group > 15u) {
            return;
        }
        uint index = 16u * group + (e & 15u);
        clut[index] = raw & 0xFFFFu;
        clut[index + 256u] = raw >> 16;
    } else {
        clut[(16u * pc.csa + e) & 511u] = raw & 0xFFFFu;
    }
}
